{
  "name": "summertime-port",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A clean vanilla TypeScript port of SummerTime, with P2P multiplayer over iroh-gossip.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && bunx wrangler deploy",
    "build:wasm": "bash scripts/build-wasm.sh"
  },
  "dependencies": {
    "gsap": "3.11.3",
    "summer-iroh": "file:multiplayer/browser-wasm/pkg",
    "three": "0.148.0",
    "three-mesh-bvh": "0.5.24"
  },
  "devDependencies": {
    "@types/three": "0.148.0",
    "typescript": "5.9.3",
    "vite": "^5.4.0",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1"
  }
}
