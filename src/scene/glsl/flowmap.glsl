vec4 applyFlowmap(sampler2D tex,vec2 uvtex,sampler2D flowmap,vec2 uvflow,float speed,vec2 displacement){vec3 flow=texture2D(flowmap,uvflow).rgb;vec2 disp=(flow.rg*2.0-1.0)*vec2(-1.0,1.0)*displacement;float t=time*speed+flow.b;float disp1=fract(t);float disp2=fract(t+0.5);vec4 t1=texture2D(tex,uvtex-disp*disp1);vec4 t2=texture2D(tex,uvtex-disp*disp2);return mix(t1,t2,power2InOut(abs(disp1*2.0-1.0)));}
