vec2 rotateUV(vec2 uv,float rotation,vec2 mid){return vec2(cos(rotation)*(uv.x-mid.x)+sin(rotation)*(uv.y-mid.y)+mid.x,cos(rotation)*(uv.y-mid.y)-sin(rotation)*(uv.x-mid.x)+mid.y);}vec2 rotateUV(vec2 uv,float rotation,float mid){return rotateUV(uv,rotation,vec2(mid));}vec2 rotateUV(vec2 uv,float rotation){return rotateUV(uv,rotation,vec2(0.5));}vec2 scaleUV(vec2 uv,float scale,vec2 mid){uv-=mid;uv*=1.0/scale;uv+=mid;return uv;}vec2 scaleUV(vec2 uv,float scale,float mid){return scaleUV(uv,scale,vec2(mid));}vec2 scaleUV(vec2 uv,float scale){return scaleUV(uv,scale,vec2(0.5));}
