float linstep(float begin,float end,float t){return clamp((t-begin)/(end-begin),0.0,1.0);}float falloff(float _input,float start,float end,float margin,float progress){float p=mix(start-margin,end,progress);return linstep(p+margin,p,_input);}float falloffsmooth(float _input,float start,float end,float margin,float progress){float p=mix(start-margin,end,progress);return smoothstep(p+margin,p,_input);}float falloff(vec2 _input,vec2 start,vec2 dir,float margin,float dist){vec2 d=normalize(dir);return linstep(0.0,-margin,dot(d,_input-start-d*dist));}float falloffsmooth(vec2 _input,vec2 start,vec2 dir,float margin,float dist){vec2 d=normalize(dir);return smoothstep(0.0,-margin,dot(d,_input-start-d*dist));}float falloff(vec3 _input,vec3 start,vec3 dir,float margin,float dist){vec3 d=normalize(dir);return linstep(0.0,-margin,dot(d,_input-start-d*dist));}float falloffsmooth(vec3 _input,vec3 start,vec3 dir,float margin,float dist){vec3 d=normalize(dir);return smoothstep(0.0,-margin,dot(d,_input-start-d*dist));}
